generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  excerpt   String
  category  String
  authorId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
