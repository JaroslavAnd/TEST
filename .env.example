# === StudyHub Environment Variables ===

# Підключення до бази даних
DATABASE_URL="postgresql://user:password@localhost:5432/studyhub?schema=public"

# Auth.js secret (згенерувати: npx auth secret)
AUTH_SECRET=""

# Google OAuth (https://console.developers.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Публічні змінні (доступні браузеру через NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_APP_NAME="StudyHub"

# Середовище: development | production
APP_ENV="development"
